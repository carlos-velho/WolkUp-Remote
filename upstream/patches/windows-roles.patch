+  Future<void> _showWolkUpHistory(BuildContext context) async {
+    final response = await bind.mainGetCommon(key: 'wolkup-session-history');
+    if (!context.mounted) return;
+    final entries = response.isEmpty ? const [] : jsonDecode(response) as List;
+    await showDialog<void>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Histórico de atendimentos'),
+        content: SizedBox(
+          width: 420,
+          height: 300,
+          child: response.isEmpty
+              ? const Text('Não foi possível carregar o histórico.')
+              : entries.isEmpty
+                  ? const Text('Nenhum atendimento registrado.')
+                  : ListView.builder(
+                      itemCount: entries.length,
+                      itemBuilder: (context, index) {
+                        final entry = entries[index] as Map;
+                        final date = DateTime.parse(entry['utc'] as String)
+                            .toLocal();
+                        final event = entry['event'] == 'connected'
+                            ? 'Conexão iniciada'
+                            : 'Conexão encerrada';
+                        final localizations = MaterialLocalizations.of(context);
+                        return ListTile(
+                          title: Text('$event · ${entry['peer_id']}'),
+                          subtitle: Text(
+                            '${localizations.formatShortDate(date)} '
+                            '${localizations.formatTimeOfDay(TimeOfDay.fromDateTime(date))}',
+                          ),
+                        );
+                      },
+                    ),
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(),
+            child: const Text('Fechar'),
+          ),
+        ],
+      ),
+    );
+  }
