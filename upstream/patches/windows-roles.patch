diff --git a/src/wolkup_history.rs b/src/wolkup_history.rs
new file mode 100644
index 0000000..74524e4
--- /dev/null
+++ b/src/wolkup_history.rs
@@ -0,0 +1,82 @@
+use chrono::Utc;
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::VecDeque,
+    fs::{self, File, OpenOptions},
+    io::{self, BufRead, BufReader, Seek, SeekFrom, Write},
+    path::PathBuf,
+};
+use uuid::Uuid;
+
+#[derive(Deserialize, Serialize)]
+struct Entry {
+    utc: String,
+    session: String,
+    peer_id: String,
+    event: String,
+}
+
+fn history_path() -> io::Result<PathBuf> {
+    let path = hbb_common::config::Config::path("atendimentos.jsonl");
+    if !path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::NotFound,
+            "Windows user profile is unavailable",
+        ));
+    }
+    Ok(path)
+}
+
+pub(crate) fn record(session: Uuid, peer_id: &str, event: &str) {
+    if let Err(err) = append(Entry {
+        utc: Utc::now().to_rfc3339(),
+        session: session.to_string(),
+        peer_id: peer_id.chars().take(256).collect(),
+        event: event.to_owned(),
+    }) {
+        hbb_common::log::warn!("Could not save WolkUp session history: {err}");
+    }
+}
+
+fn append(entry: Entry) -> io::Result<()> {
+    let path = history_path()?;
+    if let Some(dir) = path.parent() {
+        fs::create_dir_all(dir)?;
+    }
+    let mut line = serde_json::to_vec(&entry)?;
+    line.push(b'\n');
+    OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)?
+        .write_all(&line)
+}
+
+#[cfg(feature = "flutter")]
+pub(crate) fn read() -> io::Result<String> {
+    const MAX_BYTES: u64 = 256 * 1024;
+    const MAX_ENTRIES: usize = 200;
+
+    let file = match File::open(history_path()?) {
+        Ok(file) => file,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok("[]".to_owned()),
+        Err(err) => return Err(err),
+    };
+    let mut buffer = BufReader::new(file);
+    let start = buffer.get_ref().metadata()?.len().saturating_sub(MAX_BYTES);
+    if start > 0 {
+        buffer.seek(SeekFrom::Start(start))?;
+        buffer.read_until(b'\n', &mut Vec::new())?;
+    }
+    let mut entries = VecDeque::new();
+    for line in buffer.split(b'\n') {
+        if let Ok(entry) = serde_json::from_slice::<Entry>(&line?) {
+            if entries.len() == MAX_ENTRIES {
+                entries.pop_front();
+            }
+            entries.push_back(entry);
+        }
+    }
+    entries.make_contiguous().reverse();
+    Ok(serde_json::to_string(&entries)?)
+}
