+pub(crate) fn wolkup_operator_is_authorized() -> bool {
+    use windows::{
+        core::{BOOL, PCWSTR},
+        Win32::{
+            Foundation::{LocalFree, HLOCAL},
+            Security::{Authorization::ConvertStringSidToSidW, CheckTokenMembership, PSID},
+        },
+    };
+    use winreg::{enums::HKEY_LOCAL_MACHINE, RegKey};
+
+    let Ok(key) = RegKey::predef(HKEY_LOCAL_MACHINE).open_subkey(r"SOFTWARE\WolkUp\Remote")
+    else {
+        return false;
+    };
+    let Ok(group_sid) = key.get_value::<String, _>("OperatorGroupSid") else {
+        return false;
+    };
+    if !group_sid.starts_with("S-1-5-21-") || group_sid.contains('\0') {
+        return false;
+    }
+    let group_sid: Vec<u16> = group_sid.encode_utf16().chain(Some(0)).collect();
+    let mut sid = PSID::default();
+    let mut is_member = BOOL::default();
+    // The Windows API allocates the SID, then reads it to check the current token.
+    unsafe {
+        if ConvertStringSidToSidW(PCWSTR(group_sid.as_ptr()), &mut sid).is_err() {
+            return false;
+        }
+        let result = CheckTokenMembership(None, sid, &mut is_member);
+        let _ = LocalFree(Some(HLOCAL(sid.0)));
+        result.is_ok() && is_member.as_bool()
+    }
+}
